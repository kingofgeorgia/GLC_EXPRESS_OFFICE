<%@ Page Title="GLC Operations" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Operations.aspx.cs" Inherits="GLC_EXPRESS.Operations" %>
<%@ Import Namespace="System.Linq" %>
<asp:Content ID="OperationsContent" ContentPlaceHolderID="MainContent" runat="server">
<link href="<%= AssetUrl("~/Content/operations.css") %>" rel="stylesheet" />
<div class="ops-app">
<aside class="ops-sidebar"><div class="ops-logo">GLC <span>Express</span><small>OPERATIONS SYSTEM</small></div>
<nav aria-label="Разделы Operations">
<% var sections = new[] { "dashboard", "trips", "cars", "finance", "clients", "carriers" }; var labels = new[] { "▦ Панель", "Рейсы", "Автомобили", "Экономика", "Клиенты", "Перевозка" }; for (int i = 0; i < sections.Length; i++) { %>
<a class="<%= Section == sections[i] ? "active" : "" %>" href="<%= Url(sections[i], SelectedTrip == null ? null : SelectedTrip.Id) %>" <%= Section == sections[i] ? "aria-current=\"page\"" : "" %>><%: labels[i] %></a><% } %>
</nav><a class="ops-return" href="<%= CrmUrl("dashboard") %>">← Полная CRM</a></aside>
<main class="ops-main">
<header class="ops-topbar"><div><h1><%: Section == "dashboard" ? "Операционная панель" : Section == "trips" ? "Рейсы" : Section == "cars" ? "Автомобили" : Section == "finance" ? "Экономика" : Section == "clients" ? "Клиенты" : "Перевозка" %></h1><p>GLC Operations System · <%: UpdatedAt %> · Тбилиси</p></div><button type="button" class="ops-btn primary" data-open="trip-dialog">+ Новый рейс</button></header>
<% if (!string.IsNullOrEmpty(ErrorMessage)) { %><div class="ops-alert error" role="alert"><%: ErrorMessage %></div><% } %>
<% if (!string.IsNullOrEmpty(Notice)) { %><div class="ops-alert" role="status"><%: Notice %></div><% } %>
<input type="hidden" name="opsToken" value="<%: Token %>" /><input type="hidden" name="tripId" value="<%: SelectedTrip == null ? "" : SelectedTrip.Id %>" />
<% if (Section == "dashboard") { %>
<section class="ops-grid4" aria-label="Сводка"><div class="ops-card kpi"><span>Активные рейсы</span><strong><%: Data.Trips.Count(Active) %></strong><small>из <%: Data.Trips.Count %> в CRM</small></div><div class="ops-card kpi"><span>Автомобили</span><strong><%: Data.Cars.Count %></strong><small>единый реестр CRM</small></div><div class="ops-card kpi"><span>Без рейса</span><strong><%: Data.Cars.Count(c => string.IsNullOrWhiteSpace(c.TripNumber)) %></strong><small>ожидают назначения</small></div><div class="ops-card kpi"><span>Прогноз маржи</span><strong>—</strong><small>нет полного учёта затрат и валюты</small></div></section>
<% } %>
<% if (Section == "dashboard" || Section == "finance") { %>
<div class="ops-layout"><section class="ops-card"><h2><%: Section == "finance" ? "Финансы текущего рейса" : "Автомобили текущего рейса" %></h2>
<% if (Section == "finance" && SelectedTrip != null) { %>
<div class="ops-money"><span>Фрахт</span><strong><%: Money(SelectedTrip.Freight) %></strong></div><div class="ops-money"><span>Предоплата</span><strong><%: Money(SelectedTrip.Prepayment) %></strong></div><div class="ops-money"><span>Расходы автомобилей</span><strong><%: Expenses(SelectedTrip) %></strong></div><p class="ops-note">Суммы из CRM без конвертации: валюта в модели не задана. Расходы включают порт, погрузку, эвакуатор, стоянку, осмотр, реэкспорт, экспертизу и доставку. Пустые суммы не считаются нулём. Прибыль не рассчитывается без полного учёта затрат.</p>
<% } %>
<div class="ops-table-wrap"><table><thead><tr><th>Автомобиль</th><th>VIN</th><th>Клиент</th><th>Статус</th><th></th></tr></thead><tbody>
<% foreach (var car in Cars(SelectedTrip)) { %><tr><td><%: CarName(car) %></td><td><%: car.Vin %></td><td><%: car.ClientName %></td><td><span class="ops-badge"><%: car.Status %></span></td><td><a class="ops-btn ghost" href="<%= CarUrl(car) %>">Открыть</a></td></tr><% } %>
<% if (Cars(SelectedTrip).Count == 0) { %><tr><td colspan="5" class="ops-empty">Нет назначенных автомобилей. Выберите рейс и добавьте автомобиль из CRM.</td></tr><% } %>
</tbody></table></div></section>
<aside><section class="ops-card"><h2>Текущий рейс</h2>
<% if (SelectedTrip != null) { %><div class="ops-trip active"><strong><%: SelectedTrip.Country %></strong><small><%: SelectedTrip.Number %> · <%: SelectedTrip.Status %></small></div>
<p class="ops-note"><%: DateLabel(SelectedTrip.StartDate) %> → <%: DateLabel(SelectedTrip.EndDate) %></p><div class="ops-money"><span>Назначено автомобилей</span><strong><%: Cars(SelectedTrip).Count %></strong></div><p class="ops-note">Вместимость не задана в автопарке.</p>
<% if (Data.Trips.Count(t => Same(t.Number, SelectedTrip.Number)) > 1) { %><p class="ops-alert error">Номер рейса повторяется. Связь с автомобилями неоднозначна: исправьте номер в CRM.</p><% } %>
<div class="ops-money"><span>Фрахт</span><strong><%: Money(SelectedTrip.Freight) %></strong></div><div class="ops-money"><span>Расходы авто</span><strong><%: Expenses(SelectedTrip) %></strong></div>
<p class="ops-note">Водитель: <%: SelectedTrip.DriverName %><br />Транспорт: <%: SelectedTrip.VehicleName %></p>
<div class="ops-actions"><button type="button" class="ops-btn primary" data-open="car-dialog">+ Добавить авто в рейс</button><button type="button" class="ops-btn dark" data-open="resources-dialog">Назначить транспорт</button><button type="button" class="ops-btn ghost" data-open="status-dialog">Изменить статус</button><a class="ops-btn ghost" href="<%= CrmUrl("trips") %>">Открыть CRM</a></div><p class="ops-note">CMR и отправка статуса клиенту пока не поддерживаются CRM.</p>
<% } else { %><p class="ops-empty">Создайте первый рейс.</p><% } %></section>
<section class="ops-card ops-spaced"><h2>Выбор рейса</h2><div class="ops-trip-list"><% foreach (var trip in Data.Trips.OrderByDescending(t => t.CreatedAtUtc)) { %><a class="ops-trip <%= SelectedTrip != null && trip.Id == SelectedTrip.Id ? "active" : "" %>" href="<%= Url(Section, trip.Id) %>"><strong><%: trip.Country %></strong><small><%: trip.Number %> · <%: trip.Status %></small></a><% } %></div></section></aside></div>
<% } %>
<% if (Section == "trips") { %><section class="ops-card"><div class="ops-table-wrap"><table><thead><tr><th>Рейс</th><th>Направление</th><th>Транспорт</th><th>Авто</th><th>Статус</th><th>Фрахт</th><th></th></tr></thead><tbody><% foreach (var trip in Data.Trips) { %><tr><td><%: trip.Number %></td><td><%: trip.Country %></td><td><%: trip.VehicleName %></td><td><%: Cars(trip).Count %></td><td><span class="ops-badge"><%: trip.Status %></span></td><td><%: Money(trip.Freight) %></td><td><a class="ops-btn ghost" href="<%= Url("dashboard", trip.Id) %>">Открыть рейс</a></td></tr><% } %></tbody></table></div><% if (Data.Trips.Count == 0) { %><p class="ops-empty">Рейсов пока нет.</p><% } %></section><% } %>
<% if (Section == "cars") { %><section class="ops-card"><label for="ops-search">Поиск по автомобилям</label><input id="ops-search" type="search" placeholder="VIN, клиент, марка или рейс" /><div class="ops-table-wrap"><table><thead><tr><th>Авто</th><th>VIN</th><th>Клиент</th><th>Местоположение</th><th>Рейс</th><th>Статус</th><th></th></tr></thead><tbody><% foreach (var car in Data.Cars) { %><tr data-search-row><td><%: CarName(car) %></td><td><%: car.Vin %></td><td><%: car.ClientName %></td><td><%: car.Location %></td><td><%: car.TripNumber %></td><td><span class="ops-badge"><%: car.Status %></span></td><td><a class="ops-btn ghost" href="<%= CarUrl(car) %>">Карточка и расходы</a></td></tr><% } %></tbody></table></div><p id="ops-empty-search" class="ops-empty" hidden>Автомобили не найдены.</p><p class="ops-note">Новые автомобили создаются из заявок в существующей CRM. <a href="<%= CrmUrl("inquiries") %>">Открыть заявки →</a></p></section><% } %>
<% if (Section == "clients") { %><section class="ops-card"><div class="ops-table-wrap"><table><thead><tr><th>Клиент</th><th>Автомобили</th><th>Направление</th><th>Менеджер</th><th>Телефон</th><th>Email</th></tr></thead><tbody><% foreach (var client in Data.Clients) { %><tr><td><%: client.Name %></td><td><%: Data.Cars.Count(c => c.ClientId == client.Id) %></td><td><%: client.Direction %></td><td><%: client.Manager %></td><td><%: client.PhoneNumber %></td><td><%: client.Email %></td></tr><% } %></tbody></table></div><a class="ops-btn ghost" href="<%= CrmUrl("clients") %>">Управлять клиентами</a></section><% } %>
<% if (Section == "carriers") { %><section class="ops-card"><h2>Транспорт и водители</h2><p class="ops-note">Перевозка использует автопарк и водителей CRM. Экспедитор хранится в карточке автомобиля; отдельного справочника перевозчиков нет.</p><div class="ops-table-wrap"><table><thead><tr><th>Автомобиль</th><th>Госномер</th><th>Водители</th></tr></thead><tbody><% foreach (var vehicle in Data.FleetVehicles) { %><tr><td><%: vehicle.CarBrand + " " + vehicle.CarModel %></td><td><%: vehicle.LicensePlate %></td><td><%: string.Join(", ", vehicle.AssignedDriverNames) %></td></tr><% } %></tbody></table></div><div class="ops-actions"><a class="ops-btn ghost" href="<%= CrmUrl("fleet") %>">Автопарк</a><a class="ops-btn ghost" href="<%= CrmUrl("drivers") %>">Водители</a></div><h2 class="ops-spaced">Экспедиторы автомобилей</h2><div class="ops-table-wrap"><table><thead><tr><th>Экспедитор</th><th>Автомобиль</th><th>Рейс</th><th></th></tr></thead><tbody><% foreach (var car in Data.Cars.Where(c => !string.IsNullOrWhiteSpace(c.Forwarder))) { %><tr><td><%: car.Forwarder %></td><td><%: CarName(car) %></td><td><%: car.TripNumber %></td><td><a href="<%= CarUrl(car) %>">Редактировать</a></td></tr><% } %></tbody></table></div></section><% } %>
<dialog id="trip-dialog" class="ops-dialog" aria-labelledby="trip-title"><div class="ops-dialog-head"><h2 id="trip-title">Новый рейс</h2><button type="button" class="ops-btn ghost" data-close aria-label="Закрыть">×</button></div><div class="ops-form-grid">
<label>Номер рейса<input name="number" required maxlength="200" value="<%: Request.Form["number"] %>" /></label><label>Направление<input name="country" required maxlength="200" value="<%: Request.Form["country"] %>" /></label>
<label>Клиент<select name="clientId" required><option value="">Выберите клиента</option><% foreach (var c in Data.Clients) { %><option value="<%: c.Id %>"><%: c.Name %></option><% } %></select></label>
<label>Водитель<select name="driverId" required><option value="">Выберите водителя</option><% foreach (var d in Data.Drivers) { %><option value="<%: d.Id %>"><%: d.FullName %></option><% } %></select></label>
<label>Транспорт<select name="vehicleId" required><option value="">Выберите транспорт</option><% foreach (var v in Data.FleetVehicles) { %><option value="<%: v.Id %>"><%: v.LicensePlate + " · " + v.CarBrand + " " + v.CarModel %></option><% } %></select></label>
<label>Дата начала<input type="date" name="start" required value="<%: Request.Form["start"] %>" /></label><label>Дата окончания<input type="date" name="end" value="<%: Request.Form["end"] %>" /></label><label>Фрахт<input type="number" min="0" step="0.01" name="freight" inputmode="decimal" required value="<%: Request.Form["freight"] %>" /></label><label>Предоплата<input type="number" min="0" step="0.01" name="advance" inputmode="decimal" required value="<%: Request.Form["advance"] ?? "0" %>" /></label></div><p class="ops-note">Клиент, водитель и транспорт выбираются из существующих справочников. Статус нового рейса: <%: Settings == null ? "" : Settings.DefaultTripStatus %>.</p><div class="ops-dialog-actions"><button type="button" class="ops-btn ghost" data-close>Отмена</button><button type="submit" class="ops-btn primary" name="opsAction" value="createTrip">Создать рейс</button></div></dialog>
<dialog id="car-dialog" class="ops-dialog" aria-labelledby="car-title"><div class="ops-dialog-head"><h2 id="car-title">Добавить автомобиль в рейс</h2><button type="button" class="ops-btn ghost" data-close aria-label="Закрыть">×</button></div><label>Автомобиль без рейса<select name="carId" required><option value="">Выберите автомобиль</option><% foreach (var c in Data.Cars.Where(c => string.IsNullOrWhiteSpace(c.TripNumber))) { %><option value="<%: c.Id %>"><%: CarName(c) + " · " + c.Vin + " · " + c.ClientName %></option><% } %></select></label><p class="ops-note">Назначение сохранится в карточке автомобиля и истории изменений.</p><div class="ops-dialog-actions"><button type="button" class="ops-btn ghost" data-close>Отмена</button><button type="submit" class="ops-btn primary" name="opsAction" value="assignCar">Добавить в рейс</button></div></dialog>
<dialog id="resources-dialog" class="ops-dialog" aria-labelledby="resources-title"><div class="ops-dialog-head"><h2 id="resources-title">Назначить транспорт и водителя</h2><button type="button" class="ops-btn ghost" data-close aria-label="Закрыть">×</button></div><label>Водитель<select name="resourceDriver" required><option value="">Выберите водителя</option><% foreach (var d in Data.Drivers) { %><option value="<%: d.Id %>" <%= SelectedTrip != null && SelectedTrip.DriverId == d.Id ? "selected" : "" %>><%: d.FullName %></option><% } %></select></label><label>Транспорт<select name="resourceVehicle" required><option value="">Выберите транспорт</option><% foreach (var v in Data.FleetVehicles) { %><option value="<%: v.Id %>" <%= SelectedTrip != null && SelectedTrip.VehicleId == v.Id ? "selected" : "" %>><%: v.LicensePlate + " · " + v.CarBrand %></option><% } %></select></label><div class="ops-dialog-actions"><button type="button" class="ops-btn ghost" data-close>Отмена</button><button type="submit" class="ops-btn primary" name="opsAction" value="resources">Сохранить</button></div></dialog>
<dialog id="status-dialog" class="ops-dialog" aria-labelledby="status-title"><div class="ops-dialog-head"><h2 id="status-title">Статус рейса</h2><button type="button" class="ops-btn ghost" data-close aria-label="Закрыть">×</button></div><label>Статус<select name="status" required><% if (Settings != null) { foreach (var s in Settings.TripStatuses) { %><option <%= SelectedTrip != null && SelectedTrip.Status == s ? "selected" : "" %>><%: s %></option><% } } %></select></label><div class="ops-dialog-actions"><button type="button" class="ops-btn ghost" data-close>Отмена</button><button type="submit" class="ops-btn primary" name="opsAction" value="status">Сохранить статус</button></div></dialog>
</main></div><script src="<%= AssetUrl("~/Scripts/operations.js") %>"></script>
</asp:Content>

